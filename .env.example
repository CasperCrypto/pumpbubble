# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env
#   npm run dev
#
# In production these do NOT come from here. The treasury and ad contact live in
# wrangler.toml [vars]; SOLANA_RPC and IMG_SECRET are set with
# `npx wrangler secret put NAME`.

# Solana RPC. The public endpoint (api.mainnet-beta.solana.com) returns 429
# under load, so payments fail to verify — use Helius, QuickNode or Triton.
# Helius gives you a URL with the key inside it, which is why this is a secret.
SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME

# Signs image-proxy URLs so /api/img cannot be used as an open relay.
# Any long random string. Generate one with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
IMG_SECRET=change-me-to-a-long-random-string

# Where boost payments land. Public by nature — it is printed in the modal.
TREASURY_WALLET=6k8T4fXq5vt3asVnywaHgfw4ApRexGHupbUU8e3TsW1C

# Where the "SLOT OPEN" ad rows link to.
AD_CONTACT=https://t.me/casper_crypto
